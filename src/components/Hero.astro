---
const NAME = 'Anish Sharma';
const BIO =
  "I'm a Software Engineer who loves solving problems users have but haven't quite put into words yet. I build things that make life easier, things that are fun to use, and sometimes just things that are cool.";
const ROLES = ['Software Engineer', 'Problem Solver', 'Builder of Things'];

const GITHUB_URL = 'https://github.com/aneeshsharma';
const LINKEDIN_URL = 'https://linkedin.com/in/anishsharma15';
---

<section class="hero">
  <div class="hero-inner">
    <div class="typewriter">
      <span id="typed-text"></span><span class="cursor">|</span>
    </div>
    <h1>{NAME}</h1>
    <p class="bio">{BIO}</p>
    <div class="ctas">
      <a href="/#projects" class="cta-primary">View Projects</a>
      <a href="/#contact" class="cta-secondary">Get in Touch</a>
    </div>
    <div class="socials">
      <a href={GITHUB_URL} aria-label="GitHub" target="_blank" rel="noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.17c-3.2.7-3.87-1.35-3.87-1.35-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.6.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.18v3.24c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5Z"
          ></path></svg
        >
      </a>
      <a href={LINKEDIN_URL} aria-label="LinkedIn" target="_blank" rel="noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"
          ><circle cx="4.2" cy="4.2" r="2.2"></circle><rect
            x="2.2"
            y="8.4"
            width="4"
            height="12.6"
            rx="0.3"></rect><path
            d="M9.6 8.4h3.8v1.9c.6-1.1 2-2.3 4.1-2.3 4.4 0 5.6 2.5 5.6 6.8v6.6h-4V15.6c0-1.6-.3-3.2-2.2-3.2-1.9 0-2.5 1.4-2.5 3.2v5.8h-4V8.4Z"
          ></path></svg
        >
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-image:
      repeating-linear-gradient(var(--hero-line) 0px, var(--hero-line) 1px, transparent 1px, transparent 34px),
      repeating-linear-gradient(90deg, var(--hero-line) 0px, var(--hero-line) 1px, transparent 1px, transparent 34px),
      linear-gradient(180deg, var(--hero-wash-from) 0%, var(--hero-wash-to) 100%);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 130px 48px 110px;
    text-align: center;
  }

  .typewriter {
    font-family: var(--font-mono);
    color: var(--orange);
    font-size: 17px;
    margin-bottom: 14px;
    font-weight: 600;
    height: 24px;
  }

  .cursor {
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes cursor-blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  h1 {
    font-size: 56px;
    line-height: 1.1;
    margin: 0 0 20px;
    font-weight: 800;
    text-wrap: pretty;
  }

  .bio {
    font-size: 18px;
    line-height: 1.65;
    color: var(--dim);
    max-width: 560px;
    margin: 0 auto 34px;
    text-wrap: pretty;
  }

  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 32px;
  }

  .cta-primary,
  .cta-secondary {
    padding: 13px 26px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 15px;
  }

  .cta-primary {
    background: var(--yellow);
    color: var(--bg);
  }

  .cta-secondary {
    border: 1px solid var(--border-strong);
    color: var(--body-color);
  }

  .socials {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .socials a {
    color: var(--dim);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  @media (max-width: 768px) {
    .hero-inner {
      padding: 90px 24px 70px;
    }

    h1 {
      font-size: 40px;
    }

    .bio {
      font-size: 16px;
    }
  }
</style>

<script define:vars={{ ROLES }}>
  const target = document.getElementById('typed-text');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion) {
    target.textContent = ROLES[0];
  } else {
    let text = '';
    let roleIndex = 0;
    let deleting = false;

    function tick() {
      const full = ROLES[roleIndex];
      let delay = 60;

      if (!deleting) {
        text = full.slice(0, text.length + 1);
        if (text === full) {
          deleting = true;
          delay = 1800;
        }
      } else {
        text = text.slice(0, -1);
        if (text === '') {
          deleting = false;
          roleIndex = (roleIndex + 1) % ROLES.length;
          delay = 300;
        } else {
          delay = 35;
        }
      }

      target.textContent = text;
      setTimeout(tick, delay);
    }

    tick();
  }
</script>
