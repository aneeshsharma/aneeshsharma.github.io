---
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import ContactIcon from './icons/ContactIcon.astro';

const NAME = 'Anish Sharma';
const BIO =
  "I'm a Software Engineer who loves solving problems users have but haven't quite put into words yet. I build things that make life easier, things that are fun to use, and sometimes just things that are cool.";
const ROLES = ['Software Engineer', 'Problem Solver', 'Builder of Things'];

const GITHUB_URL = 'https://github.com/aneeshsharma';
const LINKEDIN_URL = 'https://linkedin.com/in/anishsharma15';
---

<section class="hero">
  <div class="hero-inner">
    <div class="typewriter">
      <span id="typed-text"></span><span class="cursor">|</span>
    </div>
    <h1>{NAME}</h1>
    <p class="bio">{BIO}</p>
    <div class="ctas">
      <a href="/#projects" class="cta-primary">View Projects</a>
      <a href="/blog" class="cta-secondary">View Blog</a>
    </div>
    <div class="socials">
      <a href={GITHUB_URL} aria-label="GitHub" target="_blank" rel="noreferrer">
        <GitHubIcon size={18} />
      </a>
      <a href={LINKEDIN_URL} aria-label="LinkedIn" target="_blank" rel="noreferrer">
        <LinkedInIcon size={18} />
      </a>
      <a href="/#contact" aria-label="Contact">
        <ContactIcon size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-image:
      repeating-linear-gradient(var(--hero-line) 0px, var(--hero-line) 1px, transparent 1px, transparent 34px),
      repeating-linear-gradient(90deg, var(--hero-line) 0px, var(--hero-line) 1px, transparent 1px, transparent 34px),
      linear-gradient(180deg, var(--hero-wash-from) 0%, var(--hero-wash-to) 100%);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 130px 48px 110px;
    text-align: center;
  }

  .typewriter {
    font-family: var(--font-mono);
    color: var(--orange);
    font-size: 17px;
    margin-bottom: 14px;
    font-weight: 600;
    height: 24px;
  }

  .cursor {
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes cursor-blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  h1 {
    font-size: 56px;
    line-height: 1.1;
    margin: 0 0 20px;
    font-weight: 800;
    text-wrap: pretty;
  }

  .bio {
    font-size: 18px;
    line-height: 1.65;
    color: var(--dim);
    max-width: 560px;
    margin: 0 auto 34px;
    text-wrap: pretty;
  }

  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 32px;
  }

  .cta-primary,
  .cta-secondary {
    padding: 13px 26px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 15px;
  }

  .cta-primary {
    background: var(--yellow);
    color: var(--bg);
  }

  .cta-secondary {
    border: 1px solid var(--border-strong);
    color: var(--body-color);
  }

  .socials {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .socials a {
    color: var(--dim);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 8px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .socials a:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .socials a {
      transition: none;
    }

    .socials a:hover {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .hero-inner {
      padding: 90px 24px 70px;
    }

    h1 {
      font-size: 40px;
    }

    .bio {
      font-size: 16px;
    }
  }
</style>

<script define:vars={{ ROLES }}>
  const target = document.getElementById('typed-text');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion) {
    target.textContent = ROLES[0];
  } else {
    let text = '';
    let roleIndex = 0;
    let deleting = false;

    function tick() {
      const full = ROLES[roleIndex];
      let delay = 60;

      if (!deleting) {
        text = full.slice(0, text.length + 1);
        if (text === full) {
          deleting = true;
          delay = 1800;
        }
      } else {
        text = text.slice(0, -1);
        if (text === '') {
          deleting = false;
          roleIndex = (roleIndex + 1) % ROLES.length;
          delay = 300;
        } else {
          delay = 35;
        }
      }

      target.textContent = text;
      setTimeout(tick, delay);
    }

    tick();
  }
</script>
