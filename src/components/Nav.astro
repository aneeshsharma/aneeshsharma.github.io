---
interface Props {
  path?: string;
}

const { path = '~/homepage' } = Astro.props;

const tabs = [
  { href: '/#about', label: 'about', accent: 'var(--yellow)' },
  { href: '/#work', label: 'work', accent: 'var(--blue)' },
  { href: '/#projects', label: 'projects', accent: 'var(--green-alt)' },
  { href: '/blog', label: 'blog', accent: 'var(--purple)' },
  { href: '/#contact', label: 'contact', accent: 'var(--orange)' },
];
---

<nav>
  <div class="nav-bar">
    <a href="/" class="wordmark">{path}</a>
    <div class="controls">
      <div class="tabs" id="nav-links">
        <div class="tabs-panel">
          {
            tabs.map((tab) => (
              <a href={tab.href} style={`background: ${tab.accent}`}>
                {tab.label}
              </a>
            ))
          }
        </div>
      </div>
      <button id="theme-toggle" aria-label="Toggle theme" type="button">
        <svg id="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <circle cx="8" cy="8" r="3.2" />
          <path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.3 3.3l1.1 1.1M11.6 11.6l1.1 1.1M3.3 12.7l1.1-1.1M11.6 4.4l1.1-1.1" />
        </svg>
        <svg id="icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <path d="M13.5 9.5A5.8 5.8 0 1 1 6.5 2.5a4.6 4.6 0 0 0 7 7Z" />
        </svg>
      </button>
      <button id="menu-toggle" class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links" type="button">
        <svg id="icon-menu" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M2.5 5h13M2.5 9h13M2.5 13h13" />
        </svg>
        <svg id="icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M4 4l10 10M14 4L4 14" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  /* The visible bar's own blur lives on a pseudo-element rather than on
     `nav` directly. backdrop-filter on a real ancestor isolates any
     descendant's own backdrop-filter to sampling only within that
     ancestor's box - which is exactly what broke the mobile drawer's
     blur below (it was a descendant of `nav`, so it could only "see"
     nav's own sparse background/text, not the real page behind it). A
     ::before isn't a DOM ancestor of nav's children, so it can't isolate
     them the same way. */
  nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--nav-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    pointer-events: none;
  }

  .nav-bar {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 14px 48px 0;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 20px;
    color: var(--yellow);
    padding-bottom: 12px;
  }

  .controls {
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }

  .tabs {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    flex-wrap: wrap;
  }

  /* On desktop this wrapper is invisible to layout - its children lay out
     directly in .tabs's flex row, same as before this element existed. */
  .tabs-panel {
    display: contents;
  }

  .tabs a {
    color: var(--bg);
    padding: 8px 16px;
    border-radius: 8px 8px 0 0;
  }

  #theme-toggle,
  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--nav-bg);
    border: 1px solid var(--border);
    color: var(--heading);
    width: 36px;
    height: 33px;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
  }

  .menu-toggle {
    display: none;
    position: relative;
  }

  #icon-sun.icon-hidden,
  #icon-moon.icon-hidden {
    display: none;
  }

  /* Menu/close icons crossfade + rotate into each other instead of an
     instant display:none swap. */
  .menu-toggle svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  #icon-menu {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  #icon-menu.icon-hidden {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  #icon-close {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-90deg);
  }

  #icon-close:not(.icon-hidden) {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  @media (max-width: 768px) {
    .nav-bar {
      padding: 12px 20px;
      align-items: center;
    }

    .wordmark {
      padding-bottom: 0;
    }

    .controls {
      align-items: center;
      gap: 8px;
    }

    #theme-toggle,
    .menu-toggle {
      width: 32px;
      height: 29px;
      border-radius: 8px;
    }

    .menu-toggle {
      display: flex;
    }

    /* nav::before (the nav bar's own blurred surface) grows to also cover
       the drawer while it's open, rather than the drawer painting a
       second, independent blurred layer right below it. Two adjacent
       backdrop-filter regions don't reliably composite as one seamless
       surface (subtle edge/seam artifacts at the boundary); one region
       that just gets taller has no boundary to seam at. --nav-bar-height
       and --drawer-content-height are real measured pixel heights (set
       in the script below), not guesses, so this tracks actual content. */
    nav::before {
      top: 0;
      bottom: auto;
      height: var(--nav-bar-height, 100%);
      transition:
        height 0.28s ease,
        border-color 0.28s ease;
    }

    nav:has(.tabs.open)::before {
      height: calc(var(--nav-bar-height, 0px) + var(--drawer-content-height, 0px));
      border-bottom-color: transparent;
      box-shadow: 0 8px 16px var(--page-shadow);
    }

    .tabs {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      font-size: 14px;
      /* Buttons stay put - .tabs-panel is always laid out at its natural
         height starting from the top; this wrapper just clips how much of
         it is visible, growing downward like a curtain. */
      overflow: hidden;
      max-height: 0;
      pointer-events: none;
      transition: max-height 0.28s ease;
    }

    .tabs.open {
      max-height: var(--drawer-content-height, 320px);
      pointer-events: auto;
    }

    .tabs-panel {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      padding: 10px 20px 16px;
    }

    .tabs a {
      text-align: center;
      border-radius: 8px;
      padding: 10px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle svg,
    .tabs,
    nav::before {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const themeButton = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');

    function syncTheme() {
      const theme = document.documentElement.getAttribute('data-theme');
      sunIcon.classList.toggle('icon-hidden', theme !== 'light');
      moonIcon.classList.toggle('icon-hidden', theme !== 'dark');
    }

    syncTheme();

    themeButton.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });

    // Keep in sync regardless of what changed the theme (this click, or the
    // OS-preference listener in BaseLayout).
    new MutationObserver(syncTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    const menuButton = document.getElementById('menu-toggle');
    const menuIcon = document.getElementById('icon-menu');
    const closeIcon = document.getElementById('icon-close');
    const navLinks = document.getElementById('nav-links');
    const navBar = document.querySelector('.nav-bar');
    const tabsPanel = document.querySelector('.tabs-panel');

    // Real measured heights, not guesses - lets nav::before grow to
    // exactly cover the drawer (see the CSS comment above) and lets the
    // drawer's own max-height match its actual content instead of a
    // padded guess.
    function measureNav() {
      document.documentElement.style.setProperty('--nav-bar-height', `${navBar.offsetHeight}px`);
      document.documentElement.style.setProperty('--drawer-content-height', `${tabsPanel.scrollHeight}px`);
    }

    measureNav();
    window.addEventListener('resize', measureNav);
    // Web fonts can still be loading at initial measurement time, which
    // renders text in a fallback font with different metrics and
    // undersizes the measurement - re-measure once the real fonts land.
    if (document.fonts) {
      document.fonts.ready.then(measureNav);
    }

    function setMenuOpen(open) {
      if (open) measureNav();
      navLinks.classList.toggle('open', open);
      menuButton.setAttribute('aria-expanded', String(open));
      menuIcon.classList.toggle('icon-hidden', open);
      closeIcon.classList.toggle('icon-hidden', !open);
    }

    // Initialize icon state explicitly - without this, both the menu and
    // close icons render on first paint since neither has the
    // icon-hidden class until a click happens.
    setMenuOpen(false);

    menuButton.addEventListener('click', () => {
      setMenuOpen(!navLinks.classList.contains('open'));
    });

    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    // Avoid a stuck-open dropdown if the viewport grows back past the
    // mobile breakpoint (e.g. rotating a tablet, resizing a window).
    window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) setMenuOpen(false);
    });
  })();
</script>
