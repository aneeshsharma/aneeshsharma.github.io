---
import SunIcon from './icons/SunIcon.astro';
import MoonIcon from './icons/MoonIcon.astro';
import MonitorIcon from './icons/MonitorIcon.astro';
import MenuIcon from './icons/MenuIcon.astro';
import CloseIcon from './icons/CloseIcon.astro';

interface Props {
  path?: string;
}

const { path = '~/homepage' } = Astro.props;

const tabs = [
  { href: '/#about', label: 'about', accent: 'var(--yellow)' },
  { href: '/#work', label: 'work', accent: 'var(--blue)' },
  { href: '/#projects', label: 'projects', accent: 'var(--green-alt)' },
  { href: '/blog', label: 'blog', accent: 'var(--purple)' },
  { href: '/#contact', label: 'contact', accent: 'var(--orange)' },
];
---

<nav>
  <div class="nav-bar">
    <a href="/" class="wordmark">{path}</a>
    <div class="controls">
      <div class="tabs" id="nav-links">
        <div class="tabs-panel">
          {
            tabs.map((tab) => (
              <a href={tab.href} style={`background: ${tab.accent}`}>
                {tab.label}
              </a>
            ))
          }
        </div>
      </div>
      <button id="theme-toggle" aria-label="Toggle theme" type="button">
        <SunIcon id="icon-sun" />
        <MoonIcon id="icon-moon" />
        <MonitorIcon id="icon-system" />
      </button>
      <button id="menu-toggle" class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links" type="button">
        <MenuIcon id="icon-menu" />
        <CloseIcon id="icon-close" />
      </button>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--nav-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    pointer-events: none;
  }

  .nav-bar {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 14px 48px 0;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 20px;
    color: var(--yellow);
    padding-bottom: 12px;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .controls {
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }

  .tabs {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    flex-wrap: wrap;
  }

  .tabs-panel {
    display: contents;
  }

  .tabs a {
    color: var(--bg);
    padding: 8px 16px;
    border-radius: 8px 8px 0 0;
  }

  #theme-toggle,
  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--nav-bg);
    border: 1px solid var(--border);
    color: var(--heading);
    width: 36px;
    height: 33px;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
  }

  .menu-toggle {
    display: none;
    position: relative;
  }

  :global(#icon-sun.icon-hidden),
  :global(#icon-moon.icon-hidden),
  :global(#icon-system.icon-hidden) {
    display: none;
  }

  :global(.menu-toggle svg) {
    position: absolute;
    top: 50%;
    left: 50%;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  :global(#icon-menu) {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  :global(#icon-menu.icon-hidden) {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  :global(#icon-close) {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-90deg);
  }

  :global(#icon-close:not(.icon-hidden)) {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  @media (max-width: 768px) {
    .nav-bar {
      padding: 12px 20px;
      align-items: center;
    }

    .wordmark {
      padding-bottom: 0;
    }

    .controls {
      align-items: center;
      gap: 8px;
    }

    #theme-toggle,
    .menu-toggle {
      width: 32px;
      height: 29px;
      border-radius: 8px;
    }

    .menu-toggle {
      display: flex;
    }

    nav::before {
      top: 0;
      bottom: auto;
      height: var(--nav-bar-height, 100%);
      transition:
        height 0.28s ease,
        border-color 0.28s ease;
    }

    nav:has(.tabs.open)::before {
      height: calc(var(--nav-bar-height, 0px) + var(--drawer-content-height, 0px));
      border-bottom-color: transparent;
      box-shadow: 0 8px 16px var(--page-shadow);
    }

    .tabs {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      font-size: 14px;
      overflow: hidden;
      max-height: 0;
      pointer-events: none;
      transition: max-height 0.28s ease;
    }

    .tabs.open {
      max-height: var(--drawer-content-height, 320px);
      pointer-events: auto;
    }

    .tabs-panel {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      padding: 10px 20px 16px;
    }

    .tabs a {
      text-align: center;
      border-radius: 8px;
      padding: 10px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.menu-toggle svg),
    .tabs,
    nav::before {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const themeButton = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');
    const systemIcon = document.getElementById('icon-system');
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    function syncTheme() {
      const mode = document.documentElement.getAttribute('data-theme-mode') || 'system';
      sunIcon.classList.toggle('icon-hidden', mode !== 'light');
      moonIcon.classList.toggle('icon-hidden', mode !== 'dark');
      systemIcon.classList.toggle('icon-hidden', mode !== 'system');
    }

    syncTheme();

    themeButton.addEventListener('click', () => {
      const currentMode = document.documentElement.getAttribute('data-theme-mode') || 'system';
      // Once on 'system', jump straight to whichever theme the OS *isn't*
      // showing right now, so the click always produces a visible change
      // instead of landing back on the theme already on screen.
      const order = media.matches ? ['system', 'light', 'dark'] : ['system', 'dark', 'light'];
      const nextMode = order[(order.indexOf(currentMode) + 1) % order.length];

      if (nextMode === 'system') {
        localStorage.removeItem('theme');
      } else {
        localStorage.setItem('theme', nextMode);
      }

      const theme = nextMode === 'system' ? (media.matches ? 'dark' : 'light') : nextMode;
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.setAttribute('data-theme-mode', nextMode);
    });

    // Keep in sync regardless of what changed the mode (this click, or the
    // OS-preference listener in BaseLayout, which only touches data-theme
    // while mode stays 'system').
    new MutationObserver(syncTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme-mode'],
    });

    const menuButton = document.getElementById('menu-toggle');
    const menuIcon = document.getElementById('icon-menu');
    const closeIcon = document.getElementById('icon-close');
    const navLinks = document.getElementById('nav-links');
    const navBar = document.querySelector('.nav-bar');
    const tabsPanel = document.querySelector('.tabs-panel');

    // Real measured heights, not guesses - lets nav::before grow to
    // exactly cover the drawer (see the CSS comment above) and lets the
    // drawer's own max-height match its actual content instead of a
    // padded guess.
    function measureNav() {
      document.documentElement.style.setProperty('--nav-bar-height', `${navBar.offsetHeight}px`);
      document.documentElement.style.setProperty('--drawer-content-height', `${tabsPanel.scrollHeight}px`);
    }

    measureNav();
    window.addEventListener('resize', measureNav);
    // Web fonts can still be loading at initial measurement time, which
    // renders text in a fallback font with different metrics and
    // undersizes the measurement - re-measure once the real fonts land.
    if (document.fonts) {
      document.fonts.ready.then(measureNav);
    }

    function setMenuOpen(open) {
      if (open) measureNav();
      navLinks.classList.toggle('open', open);
      menuButton.setAttribute('aria-expanded', String(open));
      menuIcon.classList.toggle('icon-hidden', open);
      closeIcon.classList.toggle('icon-hidden', !open);
    }

    // Initialize icon state explicitly - without this, both the menu and
    // close icons render on first paint since neither has the
    // icon-hidden class until a click happens.
    setMenuOpen(false);

    menuButton.addEventListener('click', () => {
      setMenuOpen(!navLinks.classList.contains('open'));
    });

    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    // Avoid a stuck-open dropdown if the viewport grows back past the
    // mobile breakpoint (e.g. rotating a tablet, resizing a window).
    window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) setMenuOpen(false);
    });
  })();
</script>
