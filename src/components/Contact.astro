---
---

<section id="contact" class="section contact-section">
  <div class="eyebrow" style="color: var(--orange)">05 / contact</div>
  <h2>Let's talk</h2>
  <div class="accent-bar" style="background: var(--orange)"></div>
  <p class="intro">Have a project in mind or just want to say hi? Drop a message below.</p>
  <form id="contact-form">
    <div class="fields">
      <input type="text" name="name" placeholder="Your name" required />
      <input type="email" name="email" placeholder="Your email" required />
    </div>
    <textarea name="message" placeholder="Your message" rows="5" required></textarea>
    <div>
      <button type="submit" id="submit-button">Send Message</button>
    </div>
  </form>
</section>

<style>
  .contact-section {
    padding-bottom: 60px;
  }

  h2 {
    font-size: 32px;
    margin: 0 0 12px;
    font-weight: 700;
  }

  .accent-bar {
    border-radius: 2px;
    margin-bottom: 24px;
  }

  .intro {
    color: var(--dim);
    font-size: 16px;
    margin: 0 0 32px;
    max-width: 560px;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 640px;
    margin-bottom: 16px;
  }

  input,
  textarea {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--body-color);
    padding: 14px 16px;
    border-radius: 6px;
    font-size: 15px;
    font-family: var(--font-body);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--faint);
  }

  textarea {
    width: 100%;
    max-width: 640px;
    box-sizing: border-box;
    margin-bottom: 20px;
    resize: vertical;
  }

  button {
    background: var(--yellow);
    color: var(--bg);
    border: none;
    padding: 14px 30px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    font-family: var(--font-body);
  }

  @media (max-width: 640px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  // TODO: wire this up to a real form backend (e.g. Formspree) before relying on it.
  (function () {
    const form = document.getElementById('contact-form');
    const button = document.getElementById('submit-button');

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      button.textContent = 'Sent ✓';
      setTimeout(() => {
        button.textContent = 'Send Message';
        form.reset();
      }, 2000);
    });
  })();
</script>
