---
---

<section id="contact" class="section contact-section">
  <div class="eyebrow" style="color: var(--orange)">05 / contact</div>
  <h2>Let's talk</h2>
  <div class="accent-bar" style="background: var(--orange)"></div>
  <p class="intro">Have a project in mind or just want to say hi? Drop a message below.</p>
  <form id="contact-form">
    <div class="fields">
      <input
        type="text"
        name="name"
        placeholder="Your name"
        required
        minlength="3"
        maxlength="80"
        pattern="[A-Za-zÀ-ÖØ-öø-ÿ\s'-]+"
        title="Name should be at least 3 letters (letters, spaces, hyphens and apostrophes only)"
      />
      <input type="email" name="email" placeholder="Your email" required maxlength="254" />
    </div>
    <textarea
      name="message"
      placeholder="Your message"
      rows="5"
      required
      minlength="10"
      maxlength="2000"
      title="Message should be at least 10 characters"></textarea>
    <div>
      <button type="submit" id="submit-button">Send Message</button>
    </div>
  </form>
</section>

<style>
  .contact-section {
    padding-bottom: 60px;
  }

  h2 {
    font-size: 32px;
    margin: 0 0 12px;
    font-weight: 700;
  }

  .accent-bar {
    border-radius: 2px;
    margin-bottom: 24px;
  }

  .intro {
    color: var(--dim);
    font-size: 16px;
    margin: 0 0 32px;
    max-width: 560px;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 640px;
    margin-bottom: 16px;
  }

  input,
  textarea {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--body-color);
    padding: 14px 16px;
    border-radius: 6px;
    font-size: 15px;
    font-family: var(--font-body);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--faint);
  }

  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--red);
  }

  textarea {
    width: 100%;
    max-width: 640px;
    box-sizing: border-box;
    margin-bottom: 20px;
    resize: vertical;
  }

  button {
    background: var(--yellow);
    color: var(--bg);
    border: none;
    padding: 14px 30px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    font-family: var(--font-body);
  }

  button:disabled {
    opacity: 0.7;
    cursor: default;
  }

  @media (max-width: 640px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xnpnqwnp';
    const form = document.getElementById('contact-form');
    const button = document.getElementById('submit-button');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = 'Sending…';

      try {
        const response = await fetch(FORMSPREE_ENDPOINT, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('Request failed');

        button.textContent = 'Sent ✓';
        form.reset();
      } catch (err) {
        button.textContent = 'Failed — try again';
      } finally {
        setTimeout(() => {
          button.disabled = false;
          button.textContent = 'Send Message';
        }, 2500);
      }
    });
  })();
</script>
