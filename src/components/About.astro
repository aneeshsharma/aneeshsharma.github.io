---
import { getCollection } from 'astro:content';

const ROTATIONS = [-3, 2, -2, 3, 1, -1];
const ACCENT_VARS = ['yellow', 'orange', 'green', 'greenAlt', 'blue', 'purple'] as const;

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
---

<section id="about" class="section">
  <div class="eyebrow" style="color: var(--yellow)">01 / about</div>
  <h2>Tech I work with</h2>
  <div class="accent-bar" style="background: var(--yellow)"></div>
  <div class="pills">
    {
      skills.map((skill, i) => {
        const accent = skill.data.accent ?? ACCENT_VARS[i % ACCENT_VARS.length];
        const varName = accent === 'greenAlt' ? '--green-alt' : `--${accent}`;
        const rotate = ROTATIONS[i % ROTATIONS.length];
        return (
          <span style={`background: var(${varName}); transform: rotate(${rotate}deg)`}>{skill.data.name}</span>
        );
      })
    }
  </div>
</section>

<style>
  h2 {
    font-size: 32px;
    margin: 0 0 12px;
    font-weight: 700;
  }

  .accent-bar {
    border-radius: 2px;
    margin-bottom: 28px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .pills span {
    color: var(--bg);
    padding: 9px 16px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 14px;
    box-shadow: 0 3px 8px var(--page-shadow);
    display: inline-block;
  }
</style>
