---
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';

const GITHUB_URL = 'https://github.com/aneeshsharma';
const LINKEDIN_URL = 'https://linkedin.com/in/anishsharma15';
---

<footer>
  <div class="links">
    <a href={GITHUB_URL} aria-label="GitHub" target="_blank" rel="noreferrer">
      <GitHubIcon size={16} />
    </a>
    <a href={LINKEDIN_URL} aria-label="LinkedIn" target="_blank" rel="noreferrer">
      <LinkedInIcon size={16} />
    </a>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 1;
    background: var(--status-bg);
    padding: 8px 20px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .links {
    display: flex;
    gap: 14px;
  }

  .links a {
    color: var(--status-text);
    display: flex;
  }
</style>
