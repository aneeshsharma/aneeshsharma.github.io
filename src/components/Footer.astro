---
const GITHUB_URL = 'https://github.com/aneeshsharma';
const LINKEDIN_URL = 'https://linkedin.com/in/anishsharma15';
const year = new Date().getFullYear();
---

<footer>
  <div class="copy">© {year} — built with gruvbox-material</div>
  <div class="links">
    <a href={GITHUB_URL} aria-label="GitHub" target="_blank" rel="noreferrer">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.17c-3.2.7-3.87-1.35-3.87-1.35-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.6.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.18v3.24c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5Z"
        ></path></svg
      >
    </a>
    <a href={LINKEDIN_URL} aria-label="LinkedIn" target="_blank" rel="noreferrer">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
        ><circle cx="4.2" cy="4.2" r="2.2"></circle><rect x="2.2" y="8.4" width="4" height="12.6" rx="0.3"
        ></rect><path
          d="M9.6 8.4h3.8v1.9c.6-1.1 2-2.3 4.1-2.3 4.4 0 5.6 2.5 5.6 6.8v6.6h-4V15.6c0-1.6-.3-3.2-2.2-3.2-1.9 0-2.5 1.4-2.5 3.2v5.8h-4V8.4Z"
        ></path></svg
      >
    </a>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 1;
    background: var(--status-bg);
    padding: 8px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .copy {
    font-family: var(--font-mono);
    color: var(--status-text);
    font-size: 12px;
  }

  .links {
    display: flex;
    gap: 14px;
  }

  .links a {
    color: var(--status-text);
    display: flex;
  }
</style>
