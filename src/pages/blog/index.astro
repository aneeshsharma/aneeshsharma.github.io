---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<BaseLayout title="~/homepage/blogs">
  <section class="section archive">
    <div class="eyebrow" style="color: var(--purple)">04 / writing</div>
    <h1>All writing</h1>
    <div class="accent-bar" style="background: var(--purple)"></div>
    <div class="list">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`}>
            <span class="title">{post.data.title}</span>
            <span class="date">{formatDate(post.data.date)}</span>
          </a>
        ))
      }
      {posts.length === 0 && <p class="empty">Nothing here yet — check back soon.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    min-height: 60vh;
    padding-bottom: 80px;
  }

  h1 {
    font-size: 32px;
    margin: 0 0 12px;
    font-weight: 700;
    color: var(--heading);
  }

  .accent-bar {
    border-radius: 2px;
    margin-bottom: 28px;
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  .list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
    color: var(--body-color);
  }

  .list a:hover .title {
    text-decoration: underline;
  }

  .title {
    font-size: 17px;
    font-weight: 600;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--faint);
    white-space: nowrap;
  }

  .empty {
    color: var(--dim);
    padding: 18px 0;
  }
</style>
