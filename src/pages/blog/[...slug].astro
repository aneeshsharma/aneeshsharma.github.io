---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout path={`~/blog/${post.id}`} description={post.data.description}>
  <article class="section post">
    <a href="/blog" class="back">← all writing</a>
    <div class="date">{formatDate(post.data.date)}</div>
    <h1>{post.data.title}</h1>
    <div class="accent-bar" style="background: var(--purple)"></div>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    padding-bottom: 80px;
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--purple);
    margin-bottom: 24px;
  }

  .back:hover {
    text-decoration: underline;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--faint);
    margin-bottom: 8px;
  }

  h1 {
    font-size: 40px;
    line-height: 1.15;
    margin: 0 0 12px;
    font-weight: 700;
    color: var(--heading);
  }

  .accent-bar {
    border-radius: 2px;
    margin-bottom: 36px;
  }

  .prose {
    font-size: 17px;
    line-height: 1.75;
    color: var(--body-color);
  }

  .prose :global(p) {
    margin: 0 0 20px;
  }

  .prose :global(a) {
    color: var(--blue);
  }

  .prose :global(a:hover) {
    text-decoration: underline;
  }

  .prose :global(h2) {
    font-size: 24px;
    margin: 36px 0 16px;
    color: var(--heading);
  }

  .prose :global(h3) {
    font-size: 20px;
    margin: 28px 0 12px;
    color: var(--heading);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    background: var(--card-bg);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 16px;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--border-strong);
    margin: 0 0 20px;
    padding-left: 16px;
    color: var(--dim);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px;
    padding-left: 24px;
  }
</style>
